# One Next.js process per instance; the instance name is its port:
#   nis-rcis-web@3000.service, nis-rcis-web@3001.service, ...
# install-ubuntu.sh starts one per CPU core and lists them in
# /etc/nginx/snippets/nis-rcis-next-upstream.conf.
[Unit]
Description=NIS-RCIS Next.js frontend (port %i)
After=network.target

[Service]
Type=simple
User=nis-rcis
Group=nis-rcis
WorkingDirectory=/var/www/nis-rcis/current/frontend/.next/standalone
EnvironmentFile=/etc/nis-rcis/frontend.env
Environment=NODE_ENV=production HOSTNAME=127.0.0.1 PORT=%i
ExecStart=/usr/bin/node server.js
Restart=always
RestartSec=3

# Hardening
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/var/www/nis-rcis/current/frontend/.next/standalone/.next/cache

[Install]
WantedBy=multi-user.target
