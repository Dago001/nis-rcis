[Unit]
Description=NIS-RCIS Next.js frontend
After=network.target

[Service]
Type=simple
User=nis-rcis
Group=nis-rcis
WorkingDirectory=/var/www/nis-rcis/current/frontend/.next/standalone
EnvironmentFile=/etc/nis-rcis/frontend.env
Environment=NODE_ENV=production HOSTNAME=127.0.0.1 PORT=3000
ExecStart=/usr/bin/node server.js
Restart=always
RestartSec=3

# Hardening
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/var/www/nis-rcis/current/frontend/.next/standalone/.next/cache

[Install]
WantedBy=multi-user.target
