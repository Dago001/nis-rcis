APP_NAME="NIS-RCIS"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_TIMEZONE=Africa/Lagos
# Public URL of this API / OAuth2 authorization server
APP_URL=http://localhost:8000

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_NG

APP_MAINTENANCE_DRIVER=file

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=daily
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=pgsql
DB_HOST=127.0.0.1
DB_PORT=5432
DB_DATABASE=nis_rcis
DB_USERNAME=nis_rcis
DB_PASSWORD=

# Sessions are only used by the OAuth2 login pages
SESSION_DRIVER=redis
SESSION_LIFETIME=30
SESSION_ENCRYPT=true
SESSION_PATH=/
SESSION_DOMAIN=null
SESSION_SECURE_COOKIE=false
SESSION_SAME_SITE=lax

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=redis
CACHE_STORE=redis
CACHE_PREFIX=nis_rcis

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="no-reply@immigration.gov.ng"
MAIL_FROM_NAME="${APP_NAME}"

# S3-compatible private storage for photos, signatures and documents.
# Use DOCUMENTS_DISK=local in development (private, not web-served).
DOCUMENTS_DISK=local
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_ENDPOINT=
AWS_USE_PATH_STYLE_ENDPOINT=true

# Next.js frontend (used in e-mail links and CORS)
FRONTEND_URL=http://localhost:3000

# OAuth2 (Laravel Passport). Keys: php artisan passport:keys
# In production prefer PASSPORT_PRIVATE_KEY / PASSPORT_PUBLIC_KEY env values
# or storage/oauth-*.key with 600 permissions.
PASSPORT_PRIVATE_KEY=
PASSPORT_PUBLIC_KEY=

RESIDENCE_CARD_FEE_NAIRA=35000
CARD_VALIDITY_YEARS=2

PAYSTACK_SECRET_KEY=
PAYSTACK_PUBLIC_KEY=

# Development only: simulate Paystack (refused when APP_ENV=production)
PAYMENTS_FAKE=true

# Reverse proxies whose X-Forwarded-For is trusted (the Nginx internal listener)
TRUSTED_PROXIES=127.0.0.1
