# Public URL of this Next.js app (OAuth redirect URIs are derived from it)
APP_URL=http://localhost:3000

# Laravel API as reached from the Next.js server (can be an internal address)
API_URL=http://127.0.0.1:8000
# Laravel authorization server as reached from the user's browser
API_PUBLIC_URL=http://localhost:8000

# Encrypts the httpOnly session cookies that hold OAuth tokens.
# Generate with: openssl rand -base64 48
SESSION_SECRET=

# From `php artisan nis:oauth-clients` in backend/
OAUTH_STAFF_CLIENT_ID=
OAUTH_STAFF_CLIENT_SECRET=
OAUTH_APPLICANT_CLIENT_ID=
OAUTH_APPLICANT_CLIENT_SECRET=

# Fingerprint scanner at the biometrics desk: secugen (SecuGen WebAPI running
# on the desk computer), simulated (testing only; refused by the live API) or off.
# NEXT_PUBLIC_FINGERPRINT_SCANNER=secugen
# NEXT_PUBLIC_FINGERPRINT_SERVICE_URL=https://localhost:8443/SGIFPCapture
# NEXT_PUBLIC_FINGERPRINT_LICENSE=
